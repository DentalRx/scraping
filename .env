# Website Scraper Configuration
# =============================

# Required: The sitemap URL to scrape
SITEMAP_URL=https://www.drcaudry.ca/sitemap.xml

# Output directory for scraped data (default: ./scraped_data)
OUTPUT_DIR=./scraped_data

# Download images? (true/false, default: true)
DOWNLOAD_IMAGES=true

# Always include the homepage even if not in sitemap (true/false, default: true)
INCLUDE_HOMEPAGE=true

# Delay between page requests in seconds (default: 1.0)
REQUEST_DELAY=1.0

# Limit number of pages to scrape (leave empty for no limit)
PAGE_LIMIT=

# =============================
# Blog Scraper Settings (scrape_blog.py)
# =============================

# Output directory for blog markdown files
BLOG_OUTPUT_DIR=./scraped_blog

# URL path that identifies blog posts (e.g., /blog/, /news/, /articles/)
BLOG_PATH=media-gallery/blog/

# Limit number of blog posts to scrape (leave empty for no limit)
BLOG_LIMIT=
