# =============================================================================
# Website Scraper configuration
# =============================================================================
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must never be committed — it holds the Notion token and the path to the
# Google service-account key.
#
#     cp .env.example .env
#
# All keys below are optional unless noted. CLI flags on scrape.py override
# these values (e.g. `--url`, `--limit`, `--output-dir`).

# -----------------------------------------------------------------------------
# Scrape settings (scrape.py / scrape_sitemap.py)
# -----------------------------------------------------------------------------

# Sitemap URL to scrape. Required unless you pass --url on the command line.
SITEMAP_URL=

# Output directory for scraped data (default: ./scraped_data).
# Ignored when --upload-drive is used (that path scrapes to a temp dir).
OUTPUT_DIR=./scraped_data

# Download images? (true/false, default: true)
DOWNLOAD_IMAGES=true

# Always include the homepage even if not in the sitemap (true/false, default: true)
INCLUDE_HOMEPAGE=true

# Delay between page requests in seconds (default: 1.0)
REQUEST_DELAY=1.0

# Limit number of pages to scrape (leave empty for no limit)
PAGE_LIMIT=

# -----------------------------------------------------------------------------
# Blog scraper settings (scrape_blog.py)
# -----------------------------------------------------------------------------

BLOG_OUTPUT_DIR=./scraped_blog
BLOG_PATH=/blog/
BLOG_LIMIT=

# -----------------------------------------------------------------------------
# Google Drive upload (scrape.py --upload-drive)
# -----------------------------------------------------------------------------

# Path to the Google service-account JSON key. The service account must be
# added as a member (Content manager or higher) of each client's shared Drive.
# See README.md → "Google Drive upload setup".
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# -----------------------------------------------------------------------------
# Notion lookup (resolves a client slug -> that client's Google Drive ID)
# -----------------------------------------------------------------------------

# Notion internal integration token (starts with "ntn_" or "secret_"). The
# integration must be shared with the Clients database. SECRET — do not commit.
NOTION_TOKEN=

# Path to the slug -> Notion page-id map (default: ./clients.yaml)
CLIENTS_YAML=./clients.yaml

# Name of the Notion page property that holds the Drive ID
# (default: "Google Drive ID"). Only change if the DB property is renamed.
NOTION_DRIVE_ID_PROPERTY=Google Drive ID

# Clients database id — reference only; the script fetches client pages by id.
NOTION_CLIENTS_DB_ID=
